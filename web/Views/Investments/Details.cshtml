@model web.Models.Investment

@{
    ViewData["Title"] = "Details";
}

<h4>Investment</h4>
<hr />
<div>
    <dl class="row">
        <dt class="col-sm-2">Amount</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Amount)</dd>

        <dt class="col-sm-2">Date</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Date)</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Description)</dd>
    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">Edit</a>
<a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back</a>