@model web.Models.ViewModels.AddRoomExpenseViewModel
@{
    ViewData["Title"] = "Add Expense";
}

<div class="container py-4">
    <div class="card shadow-sm p-3">
        <h1 class="h4 mb-3">Add Expense to Room</h1>

        <form asp-action="AddExpense" method="post">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.RoomId)

            <div class="text-danger">
                @Html.ValidationSummary(true)
            </div>

            <div class="mb-3">
                <label asp-for="Amount" class="form-label">Amount</label>
                <input asp-for="Amount" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Description</label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Participants</label>
                <button type="button" id="selectAllBtn" class="btn btn-sm btn-secondary ms-2">Select All</button>

                @for (int i = 0; i < Model.Members.Count; i++)
                {
                    <div class="form-check">
                        @Html.HiddenFor(m => m.Members[i].UserId)
                        @Html.HiddenFor(m => m.Members[i].DisplayName)
                        <input type="checkbox"
                               asp-for="Members[i].IsSelected"
                               class="form-check-input participant-checkbox"
                               id="participant_@i" />
                        <label class="form-check-label" for="participant_@i">
                            @Model.Members[i].DisplayName
                        </label>
                    </div>
                }

                <span class="text-danger">@Html.ValidationMessage("Participants")</span>
            </div>

            <button type="submit" class="btn btn-primary">Add Expense</button>
            <a asp-action="Details" asp-route-id="@Model.RoomId" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('selectAllBtn').addEventListener('click', function () {
            var checkboxes = document.querySelectorAll('.participant-checkbox');
            var allChecked = Array.from(checkboxes).every(cb => cb.checked);
            checkboxes.forEach(cb => cb.checked = !allChecked);
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
